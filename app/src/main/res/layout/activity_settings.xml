<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Title"
            android:text="Настройки ИИ" />

        <TextView
            style="@style/Label"
            android:text="Ключ AssemblyAI (распознавание)" />

        <EditText
            android:id="@+id/etAsm"
            style="@style/Field"
            android:hint="assembly_key"
            android:inputType="textPassword" />

        <TextView
            style="@style/Label"
            android:text="Ключ Groq (ответы)" />

        <EditText
            android:id="@+id/etGroq"
            style="@style/Field"
            android:hint="groq_key"
            android:inputType="textPassword" />

        <TextView
            style="@style/Label"
            android:text="Модель Groq" />

        <EditText
            android:id="@+id/etModel"
            style="@style/Field"
            android:hint="llama-3.1-8b-instant" />

        <TextView
            style="@style/Label"
            android:text="Системный промпт" />

        <EditText
            android:id="@+id/etPrompt"
            style="@style/Field"
            android:hint="Отвечай кратко, без markdown"
            android:minLines="3"
            android:gravity="top" />

        <TextView
            style="@style/Label"
            android:text="Скорость речи (0.5 — 2.0)" />

        <EditText
            android:id="@+id/etRate"
            style="@style/Field"
            android:hint="1.0"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/mic"
            android:text="Сохранить"
            android:textColor="@color/text" />
    </LinearLayout>
</ScrollView>
